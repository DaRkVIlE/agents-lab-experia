# Variáveis de Ambiente — Félix Cell Bot API
# Copie este arquivo para .env e preencha com seus valores reais
# NUNCA commite o arquivo .env no Git!

# ─── Banco de Dados (Railway PostgreSQL) ──────────────────────────────────────
DATABASE_URL=postgresql://usuario:senha@hostname:5432/nome_do_banco

# ─── Evolution API (para disparar mensagens WhatsApp) ─────────────────────────
EVOLUTION_API_URL=https://evolution.seudominio.com
EVOLUTION_API_KEY=sua-api-key-aqui
EVOLUTION_INSTANCE=felixcell

# ─── Site Felix Cell ──────────────────────────────────────────────────────────
FELIX_SITE_URL=https://felixcell.netlify.app

# ─── Ambiente ─────────────────────────────────────────────────────────────────
NODE_ENV=production
# NODE_ENV=development  # Para testes locais (sem disparar mensagens reais)
